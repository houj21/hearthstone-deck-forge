# 复制本文件为 .env 后填写真实凭证；.env 已在 .gitignore 中，切勿提交仓库
# OpenAI 兼容网关地址（示例为网关根目录，SDK 自行拼接 /chat/completions）
LLM_BASE_URL=https://api.hcnsec.cn/v1

# 模型凭证（占位符，请替换为真实 key）
LLM_API_KEY=sk-REPLACE_ME

# 必须显式指定模型：model=auto 会被网关路由到只输出 reasoning_content 的推理模型，导致 content 为空
LLM_MODEL=step-5-preview
LLM_MODEL_FALLBACKS=MiMo-V2.6-Flash,DeepSeek-V4.1-Flash,Qwen3.8-27B

# 超时（秒）：网关长文本响应可能 200-330 秒
LLM_TIMEOUT=360
